#!name=江苏油价监控
#!desc=每天 09:05 自动查询江苏油价，价格变动时推送通知；面板参照「常州油价」版式（汽车之家数据）：当前价+上次涨跌、加满成本、上次调价/搁浅、下次窗口与预期价、近8次走势。
#!category=工具
#!arguments=

[Script]
江苏油价监控 = type=cron, cronexp="5 9 * * *", timeout=30, script-path=https://raw.githubusercontent.com/Marsdyh-max/iiivvv/main/jiangsu-oil.js, argument=notify
江苏油价面板 = type=generic, timeout=20, script-path=https://raw.githubusercontent.com/Marsdyh-max/iiivvv/main/jiangsu-oil-panel.js, argument=panel

[Panel]
江苏油价 = script-name=江苏油价面板, title=江苏油价, style=info
